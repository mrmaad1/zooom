# ---------------------------------------------------------------------------
# Server (used by `npm start`, Docker, Render, Fly)
# ---------------------------------------------------------------------------
PORT=3000
# Max participants per room (mesh WebRTC)
MAX_PARTICIPANTS=24

# ---- privacy / ICE ---------------------------------------------------------
# false => never contact third-party STUN servers (privacy mode). You then need
# your own TURN server, otherwise peers on strict NATs cannot connect.
ALLOW_PUBLIC_STUN=true
# Optional self-hosted TURN (recommended for privacy + connectivity)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- split deployment ------------------------------------------------------
# Comma-separated browser origins allowed to call /api/* and open /ws from a
# different domain. Only needed when the frontend is hosted elsewhere
# (e.g. Vercel) and this server only does signaling.
# ALLOWED_ORIGINS=https://zooom.vercel.app,https://zooom-git-main-you.vercel.app

# ---------------------------------------------------------------------------
# Frontend build-time (only for split deployments — Vercel/Netlify static host)
# ---------------------------------------------------------------------------
# Where the signaling server lives. Leave empty when the same server serves
# both the app and /ws (Docker/Render/Fly/all-in-one).
# VITE_API_BASE=https://zooom-signal.onrender.com
# Optional explicit WebSocket endpoint (overrides VITE_API_BASE)
# VITE_WS_URL=wss://zooom-signal.onrender.com/ws
